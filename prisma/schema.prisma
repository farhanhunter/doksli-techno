generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dokumentasi {
  id           Int      @id @default(autoincrement())
  namaKegiatan String   @map("nama_kegiatan") @db.VarChar(150)
  deskripsi    String?
  lokasi       String?  @db.VarChar(150)
  tanggal      DateTime @db.Date
  uploader     String?  @db.VarChar(100)
  kategori     String?  @db.VarChar(50)
  imageUrl     String   @map("image_url")
  publicId     String   @map("public_id")
  width        Int?
  height       Int?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tanggal(sort: Desc)])
  @@index([kategori])
  @@map("dokumentasi")
}
